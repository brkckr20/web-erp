  genelToplam       Decimal? @map("genel_toplam") @db.Decimal(18, 6)
  sira              Int      @default(0)

  kumasGruplari     SiparisRenkKumasGrup[] @relation("SiparisRenkKumasGruplar")
  bedenler          SiparisRenkBeden[] @relation("SiparisRenkBedenler")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([siparisKalemId])
  @@map("siparis_renk")
}

model SiparisRenkKumasGrup {
  id                Int      @id @default(autoincrement())
  siparisRenkId     Int      @map("siparis_renk_id")
  siparisRenk       SiparisRenk @relation("SiparisRenkKumasGruplar", fields: [siparisRenkId], references: [id], onDelete: Cascade)
  kumasGrupId       Int      @map("kumas_grup_id")
  kumasGrup         KumasGrup? @relation("SiparisRenkKumasGrupRef", fields: [kumasGrupId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  renkId            Int?     @map("renk_id")
  renk              Renk?    @relation("SiparisRenkRenkRef", fields: [renkId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([siparisRenkId, kumasGrupId])
  @@map("siparis_renk_kumas_grup")
}

model SiparisRenkBeden {
  id                Int      @id @default(autoincrement())
  siparisRenkId     Int      @map("siparis_renk_id")
  siparisRenk       SiparisRenk @relation("SiparisRenkBedenler", fields: [siparisRenkId], references: [id], onDelete: Cascade)
  bedenId           Int      @map("beden_id")
  beden             Beden?   @relation("SiparisRenkBedenRef", fields: [bedenId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  miktar            Decimal? @db.Decimal(18, 6)
  fiyat             Decimal? @db.Decimal(18, 6)
  aciklama          String?  @db.NVarChar(1000)
  barkod            String?  @db.VarChar(100)
  sira              Int      @default(0)

  stickerler        SiparisSticker[] @relation("SiparisStickerler")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([siparisRenkId, bedenId])
  @@index([siparisRenkId])
  @@map("siparis_renk_beden")
}

model SiparisSticker {
  id                Int      @id @default(autoincrement())
  siparisRenkBedenId Int     @map("siparis_renk_beden_id")
  siparisRenkBeden  SiparisRenkBeden @relation("SiparisStickerler", fields: [siparisRenkBedenId], references: [id], onDelete: Cascade)
  sira              Int
  deger             String?  @db.NVarChar(200)

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([siparisRenkBedenId, sira])
  @@map("siparis_sticker")
}

model SiparisAciklama {
  id                Int      @id @default(autoincrement())
  siparisId         Int      @map("siparis_id")
  siparis           Siparis  @relation("SiparisAciklamalar", fields: [siparisId], references: [id], onDelete: Cascade)
  tip               String   @db.VarChar(20)
  metin             String?  @db.NVarChar(MAX)

  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([siparisId, tip])
  @@map("siparis_aciklama")
}
